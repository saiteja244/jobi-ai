# Local dev: leave empty — Vite proxies /api to backend
VITE_API_URL=

# Local proxy target (backend)
VITE_API_PROXY=http://localhost:5000

# Production (Vercel) — Option A: set here and redeploy
# VITE_API_URL=https://YOUR-SERVICE.onrender.com/api
#
# Option B: edit frontend/public/api-config.json + frontend/vercel.json
# See DEPLOY.md in repo root
